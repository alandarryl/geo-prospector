# Copier en .env :  cp .env.example .env   (le .env n'est jamais commité)
POSTGRES_DB=bpe
POSTGRES_USER=bpe
POSTGRES_PASSWORD=bpe_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=change-me-en-local
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Code région INSEE de votre groupe (24, 27, 28, 52 ou 53)
BPE_REGION=28
BPE_PARQUET_PATH=/data/bpe.parquet
